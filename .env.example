# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# --- Supabase ---
# Project: robinhood-personas (ref ufkaoyvdhicwdwbckutx), org Chibibytes, us-east-1
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=            # service-role key, SERVER-SIDE ONLY (bypasses RLS)

# --- Market data & news ---
FINNHUB_API_KEY=                 # prices + market/company news (free tier)
# News ingestion (ingest/news.py) — optional override:
NEWS_LOOKBACK_DAYS=1             # Finnhub company-news lookback in days

# --- SEC EDGAR (no key, but they 403 generic/absent user-agents) ---
# Fair-access contact — use a ROLE address, never a personal inbox.
SEC_USER_AGENT=Chibibytes Research team@dulcenochemedia.com
# 13F ingester (ingest/architect_13f.py) — quarters to keep/diff (default 2):
INST_KEEP_PERIODS=2

# --- Reddit social buzz (The Shut-In — ingest/reddit_sentiment.py) ---
# Reddit is reached via Composio (its servers make the call → no datacenter-IP block).
COMPOSIO_API_KEY=                # Composio platform API key (server-side)
COMPOSIO_REDDIT_ACCOUNT_ID=      # Composio connected-account id for the Reddit connection
# COMPOSIO_USER_ID=default       # Composio entity id (v3 execute requires it; default "default")
# COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3   # override if the API version moves
SOCIAL_RETENTION_DAYS=90         # rolling window for reddit_buzz/reddit_threads (3 months)

# --- Report generation ---
ANTHROPIC_API_KEY=               # also used for The Shut-In's tier-3 LLM post read

# --- Ops ---
DISCORD_WEBHOOK_URL=             # failure alerts
